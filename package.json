{
  "name": "sc-ptz-control",
  "displayName": "SC PTZ Control",
  "version": "4.1.2",
  "main": "dist/backend/main.js",
  "type": "module",
  "icon": "build/icon.png",
  "description": "App feito com electron e Next para controlar camera ptz usando a api do seu DVR/NVR",
  "private": false,
  "author": {
    "name": "Saulo Costa",
    "email": "saulotarsobc@gmail.com",
    "url": "https://github.com/saulotarsobc/sc-ptz-control"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/saulotarsobc/sc-ptz-control.git"
  },
  "scripts": {
    "predev": "dotnet build native/PtzBridge",
    "dev": "vite",
    "preview": "vite preview",
    "build": "tsc && vite build",
    "build:bridge": "dotnet build native/PtzBridge/PtzBridge.csproj",
    "build:vcam": "tsx scripts/build-vcam.ts",
    "install:vcam": "tsx scripts/install-vcam.ts",
    "publish:bridge": "tsx scripts/publish-bridge.ts",
    "lint": "eslint . --ext .ts,.tsx",
    "postinstall": "electron-builder install-app-deps",
    "update-readme": "tsx scripts/update-readme.js",
    "generate-electron-builder": "tsx scripts/generate-electron-builder.ts",
    "dist:prepare": "pnpm run generate-electron-builder && pnpm run build:vcam && pnpm run publish:bridge && pnpm run build",
    "dist:prepare:linux": "pnpm run generate-electron-builder && pnpm run build:vcam -- --target=linux && pnpm run publish:bridge -- --target=linux && pnpm run build",
    "dist": "pnpm run dist:prepare && electron-builder",
    "dist:linux": "pnpm run dist:prepare:linux && electron-builder --linux",
    "release": "pwsh -NoProfile -ExecutionPolicy Bypass -File ./scripts/release.ps1",
    "release:dry": "pwsh -NoProfile -ExecutionPolicy Bypass -File ./scripts/release.ps1 -DryRun",
    "release:notes": "pwsh -NoProfile -ExecutionPolicy Bypass -File ./scripts/changelog.ps1",
    "release:publish": "pnpm run dist:prepare && electron-builder --publish always",
    "format": "prettier --write \"src/**/*.{ts,tsx,js,jsx,json,css,scss,md}\" \"backend/**/*.{ts,tsx,js,jsx,json,css,scss,md}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,js,jsx,json,css,scss,md}\" \"backend/**/*.{ts,tsx,js,jsx,json,css,scss,md}\""
  },
  "dependencies": {
    "@mantine/core": "^9.5.1",
    "@mantine/hooks": "^9.5.1",
    "@mantine/notifications": "^9.5.1",
    "@tabler/icons-react": "^3.46.0",
    "electron-updater": "^6.8.9",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.2"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@types/request": "^2.48.13",
    "@typescript-eslint/eslint-plugin": "^8.67.0",
    "@typescript-eslint/parser": "^8.67.0",
    "@vitejs/plugin-react": "^6.0.5",
    "electron": "^43.4.0",
    "electron-builder": "^26.15.3",
    "eslint": "^10.8.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.4",
    "globals": "^17.11.0",
    "postcss": "^8.5.26",
    "postcss-preset-mantine": "^1.18.0",
    "postcss-simple-vars": "^7.0.1",
    "tsx": "^4.23.12",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.67.0",
    "vite": "^8.2.1",
    "vite-plugin-electron": "^1.1.1",
    "vite-plugin-electron-renderer": "^1.0.0",
    "prettier": "^3.9.6"
  },
  "engines": {
    "node": ">=22.12"
  }
}
