<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <!-- O bridge é puro .NET; os poucos trechos nativos são condicionais por plataforma. -->
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <!-- Em desenvolvimento, permite rodar com um runtime .NET mais novo (por exemplo,
         SDK/runtime 10 sem o runtime 8 instalado). Os pacotes finais são self-contained. -->
    <RollForward>Major</RollForward>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <AssemblyName>PtzBridge</AssemblyName>
    <RootNamespace>PtzBridge</RootNamespace>
    <Version>1.0.0</Version>
    <AssemblyVersion>1.0.0.0</AssemblyVersion>
    <FileVersion>1.0.0.0</FileVersion>
    <Product>SC PTZ Control Bridge</Product>
    <Company>SC</Company>
    <Description>Sidecar PTZ e vídeo, com NetSDK opcional e RTSP+CGI multiplataforma.</Description>
    <PlatformTarget>x64</PlatformTarget>
    <Prefer32Bit>false</Prefer32Bit>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <PublishSingleFile>false</PublishSingleFile>
    <InvariantGlobalization>true</InvariantGlobalization>

    <!-- O wrapper oficial é fonte C# não versionada, fornecida pelo pacote Windows do SDK.
         Sem ele o projeto ainda compila: fica somente o backend RTSP+CGI. -->
    <NetSdkRoot Condition="'$(NetSdkRoot)' == ''">$(MSBuildProjectDirectory)\..\..\..\helpers\NetSDK 3.050\.NET\General_NetSDK_ChnEng_CSharp64_IS_V3.050.0000005.3.R.190304</NetSdkRoot>
    <NetSdkWrapper Condition="'$(NetSdkWrapper)' == ''">$(NetSdkRoot)\Demos\RealPlayAndPTZDemo\NetSDKCS</NetSdkWrapper>
    <NetSdkLibs Condition="'$(NetSdkLibs)' == ''">$(NetSdkRoot)\libs</NetSdkLibs>
    <HasNetSdk Condition="Exists('$(NetSdkWrapper)\NetSDK.cs')">true</HasNetSdk>
    <HasNetSdk Condition="'$(HasNetSdk)' == ''">false</HasNetSdk>
  </PropertyGroup>

  <PropertyGroup Condition="'$(HasNetSdk)' == 'true'">
    <DefineConstants>$(DefineConstants);NETSDK</DefineConstants>
  </PropertyGroup>

  <!-- Sem o wrapper não há NETClient nem os tipos de callback; removemos só essa unidade. -->
  <ItemGroup Condition="'$(HasNetSdk)' != 'true'">
    <Compile Remove="NetSdk\**\*.cs" />
  </ItemGroup>

  <ItemGroup Condition="'$(HasNetSdk)' == 'true'">
    <Compile Include="$(NetSdkWrapper)\NetSDK.cs" Link="NetSDKCS\NetSDK.cs" />
    <Compile Include="$(NetSdkWrapper)\NetSDKStruct.cs" Link="NetSDKCS\NetSDKStruct.cs" />
    <Compile Include="$(NetSdkWrapper)\OriginalSDK.cs" Link="NetSDKCS\OriginalSDK.cs" />
  </ItemGroup>

  <!-- Windows SDK: *.dll. Linux SDK, se fornecido, pode ser levado no pacote como *.so. -->
  <ItemGroup Condition="'$(HasNetSdk)' == 'true' and '$(OS)' == 'Windows_NT'">
    <None Include="$(NetSdkLibs)\*.dll" Link="%(Filename)%(Extension)"
          CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
  <ItemGroup Condition="'$(HasNetSdk)' == 'true' and '$(OS)' != 'Windows_NT'">
    <None Include="$(NetSdkLibs)\*.so*" Link="%(Filename)%(Extension)"
          CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

  <PropertyGroup>
    <VCamDll>$(MSBuildProjectDirectory)\..\ScPtzVCam\build\Release\ScPtzVCam.dll</VCamDll>
  </PropertyGroup>
  <ItemGroup Condition="'$(OS)' == 'Windows_NT' and Exists('$(VCamDll)')">
    <None Include="$(VCamDll)" Link="ScPtzVCam.dll"
          CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

  <Target Name="ReportBackend" BeforeTargets="BeforeBuild">
    <Message Importance="high" Text="PtzBridge: HasNetSdk=$(HasNetSdk); OS=$(OS). RTSP+CGI está sempre disponível." />
    <Warning Condition="'$(OS)' == 'Windows_NT' and !Exists('$(VCamDll)')"
             Text="ScPtzVCam.dll não encontrada. A câmera virtual ficará indisponível até rodar scripts/build-vcam.ps1." />
  </Target>
</Project>
