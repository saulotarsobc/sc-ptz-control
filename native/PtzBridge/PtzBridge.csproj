<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <RollForward>Major</RollForward>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <AssemblyName>PtzBridge</AssemblyName>
    <RootNamespace>PtzBridge</RootNamespace>
    <Version>6.0.0</Version>
    <AssemblyVersion>6.0.0.0</AssemblyVersion>
    <FileVersion>6.0.0.0</FileVersion>
    <Product>SC PTZ Control Bridge</Product>
    <Company>SC</Company>
    <Description>Sidecar Windows x64 que expõe o NetSDK Intelbras para PTZ e vídeo.</Description>
    <PlatformTarget>x64</PlatformTarget>
    <Prefer32Bit>false</Prefer32Bit>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <PublishSingleFile>false</PublishSingleFile>
    <InvariantGlobalization>true</InvariantGlobalization>

    <!-- O wrapper oficial é fonte C# não versionada, fornecida pelo pacote Windows do SDK. -->
    <NetSdkRoot Condition="'$(NetSdkRoot)' == ''">$(MSBuildProjectDirectory)\..\..\..\helpers\NetSDK 3.050\.NET\General_NetSDK_ChnEng_CSharp64_IS_V3.050.0000005.3.R.190304</NetSdkRoot>
    <NetSdkWrapper Condition="'$(NetSdkWrapper)' == ''">$(NetSdkRoot)\Demos\RealPlayAndPTZDemo\NetSDKCS</NetSdkWrapper>
    <NetSdkLibs Condition="'$(NetSdkLibs)' == ''">$(NetSdkRoot)\libs</NetSdkLibs>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="$(NetSdkWrapper)\NetSDK.cs" Link="NetSDKCS\NetSDK.cs" />
    <Compile Include="$(NetSdkWrapper)\NetSDKStruct.cs" Link="NetSDKCS\NetSDKStruct.cs" />
    <Compile Include="$(NetSdkWrapper)\OriginalSDK.cs" Link="NetSDKCS\OriginalSDK.cs" />
  </ItemGroup>

  <ItemGroup>
    <None Include="$(NetSdkLibs)\*.dll" Link="%(Filename)%(Extension)"
          CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
  <PropertyGroup>
    <VCamDll>$(MSBuildProjectDirectory)\..\ScPtzVCam\build\Release\ScPtzVCam.dll</VCamDll>
  </PropertyGroup>
  <ItemGroup Condition="Exists('$(VCamDll)')">
    <None Include="$(VCamDll)" Link="ScPtzVCam.dll"
          CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

  <Target Name="CheckWindowsDependencies" BeforeTargets="BeforeBuild">
    <Error Condition="'$(OS)' != 'Windows_NT'"
           Text="A v6 do PtzBridge oferece suporte somente ao Windows x64." />
    <Error Condition="!Exists('$(NetSdkWrapper)\NetSDK.cs')"
           Text="NetSDK não encontrado em '$(NetSdkRoot)'. Ajuste NetSdkRoot ou restaure a pasta helpers/; a v6 não usa fallback RTSP/FFmpeg." />
    <Warning Condition="!Exists('$(VCamDll)')"
             Text="ScPtzVCam.dll não encontrada. A câmera virtual ficará indisponível até rodar scripts/build-vcam.ps1." />
  </Target>
</Project>
