<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <AssemblyName>PtzBridge</AssemblyName>
    <RootNamespace>PtzBridge</RootNamespace>

    <Version>1.0.0</Version>
    <AssemblyVersion>1.0.0.0</AssemblyVersion>
    <FileVersion>1.0.0.0</FileVersion>
    <Product>SC PTZ Control Bridge</Product>
    <Company>SC</Company>
    <Description>Sidecar headless que expõe o NetSDK Intelbras (PTZ + vídeo) por WebSocket local.</Description>

    <!-- As DLLs nativas do NetSDK são 64-bit: o processo PRECISA ser x64. -->
    <PlatformTarget>x64</PlatformTarget>
    <Prefer32Bit>false</Prefer32Bit>

    <!-- Sdk\YuvScaler.cs converte I420->NV12 com ponteiros. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>

    <!-- As DLLs nativas são carregadas por NOME a partir do disco (LoadLibrary),
         então single-file quebraria o carregamento. -->
    <PublishSingleFile>false</PublishSingleFile>
    <InvariantGlobalization>true</InvariantGlobalization>

    <!-- Raiz do NetSDK 3.050 (.NET) que fica em helpers/ na raiz do monorepo.
         Fora do monorepo, passe o caminho explicitamente:
         dotnet build -p:NetSdkRoot="C:\caminho\para\...190304" -->
    <NetSdkRoot>$(MSBuildProjectDirectory)\..\..\..\helpers\NetSDK 3.050\.NET\General_NetSDK_ChnEng_CSharp64_IS_V3.050.0000005.3.R.190304</NetSdkRoot>
    <NetSdkWrapper>$(NetSdkRoot)\Demos\RealPlayAndPTZDemo\NetSDKCS</NetSdkWrapper>
    <NetSdkLibs>$(NetSdkRoot)\libs</NetSdkLibs>
  </PropertyGroup>

  <!-- Reaproveita o wrapper P/Invoke OFICIAL (NetSDKCS) sem duplicá-lo no repo.
       São 3 arquivos: a API (NETClient), os structs e os DllImport crus. -->
  <ItemGroup>
    <Compile Include="$(NetSdkWrapper)\NetSDK.cs"       Link="NetSDKCS\NetSDK.cs" />
    <Compile Include="$(NetSdkWrapper)\NetSDKStruct.cs" Link="NetSDKCS\NetSDKStruct.cs" />
    <Compile Include="$(NetSdkWrapper)\OriginalSDK.cs"  Link="NetSDKCS\OriginalSDK.cs" />
  </ItemGroup>

  <!-- Copia as DLLs nativas (dhnetsdk.dll, dhplay.dll, etc.) para a pasta de
       saída, ao lado do .exe. Não são versionadas no git (ficam em helpers/). -->
  <ItemGroup>
    <None Include="$(NetSdkLibs)\*.dll"
          Link="%(Filename)%(Extension)"
          CopyToOutputDirectory="PreserveNewest"
          CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- Falha cedo, com mensagem clara, se o SDK não estiver presente. -->
  <Target Name="CheckNetSdk" BeforeTargets="BeforeBuild">
    <Error Condition="!Exists('$(NetSdkWrapper)\NetSDK.cs')"
           Text="NetSDK não encontrado em '$(NetSdkRoot)'. Ajuste a propriedade NetSdkRoot no .csproj ou passe -p:NetSdkRoot=..." />
  </Target>

</Project>
